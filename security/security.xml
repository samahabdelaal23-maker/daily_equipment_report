<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         Module Category
    ========================================================== -->
    <record id="module_category_equipment_inspection"
            model="ir.module.category">
        <field name="name">Equipment Inspections</field>
        <field name="description">
            Equipment inspection and maintenance access
        </field>
        <field name="sequence">35</field>
    </record>


    <!-- =========================================================
         Security Groups
    ========================================================== -->
    <record id="group_equipment_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id"
               ref="module_category_equipment_inspection"/>
    </record>

    <record id="group_equipment_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id"
               ref="module_category_equipment_inspection"/>
        <field name="implied_ids"
               eval="[(4, ref('group_equipment_user'))]"/>
    </record>


    <!-- =========================================================
         Equipment Access Rules
    ========================================================== -->

    <record id="rule_maintenance_equipment_allowed_categories" model="ir.rule">
        <field name="name">Equipment: category-based access</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">
            [(1, '=', 1)] if user.has_group('daily_equipment_report.group_equipment_manager') or not user.allowed_equipment_category_ids else [('category_id', 'in', user.allowed_equipment_category_ids.ids)]
        </field>

        <field name="groups"
               eval="[(4, ref('group_equipment_user'))]"/>

        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>

    </record>

    <!-- Managers can access all equipment -->
    <record id="rule_maintenance_equipment_manager_all" model="ir.rule">

        <field name="name">Equipment: manager unrestricted access</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">[(1, '=', 1)]</field>

        <field name="groups" eval="[(4, ref('group_equipment_manager'))]"/>

        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>

    </record>


    <!--Equipment Category Rules-->
    <record id="rule_equipment_category_user_allowed" model="ir.rule">
        <field name="name">Equipment Categories: category-based access</field>
        <field name="model_id"
               ref="maintenance.model_maintenance_equipment_category"/>

        <field name="domain_force">[(1, '=', 1)] if not user.allowed_equipment_category_ids else [('id', 'in', user.allowed_equipment_category_ids.ids)]</field>

        <field name="groups"
               eval="[(4, ref('group_equipment_user'))]"/>

        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>

    </record>


